# Binance USD-M Futures credentials (no passphrase — Binance doesn't use one)
# Restrict the API key to: Enable Reading + Enable Futures. Withdrawals OFF.
# Lead Trader keys also require IP whitelist ON (Railway Pro static outbound IP).
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# API base URLs — defaults are mainnet. Override for testnet:
#   BINANCE_FAPI_BASE_URL=https://testnet.binancefuture.com
# (Testnet has no /sapi copy-trading endpoints; the bot auto-skips them.)
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_SAPI_BASE_URL=https://api.binance.com

# Strict Lead Trader mode. When "true", the bot REFUSES to run unless
# the key is on a Lead portfolio AND the symbol is on the dynamic whitelist.
# Leave false during Phase 2 (regular Futures account, no copy trading).
# Flip to true at the start of Phase 3 (Private Lead portfolio).
BINANCE_REQUIRE_LEAD_TRADER=false

# Portfolio value — used to calculate position size
PORTFOLIO_VALUE_USD=1000

# Risk per trade as a percentage of portfolio. The bot derives position notional
# from this and the strategy's stop distance:
#   position = (portfolio × RISK_PER_TRADE_PCT/100) / (stop_loss_pct / 100)
# With portfolio $1000, RISK 1%, stop 0.3%: position ≈ $3,333 (3.3× leverage,
# inside the 5× max_leverage cap in rules.json).
RISK_PER_TRADE_PCT=1.0

# Trade limits — your hard guardrails (never exceeded regardless of sizing math)
# Recommended: PORTFOLIO_VALUE_USD × max_leverage (5×) so risk-based sizing
# isn't unnecessarily clamped. Set lower if you want a tighter cap.
MAX_TRADE_SIZE_USD=5000
MAX_TRADES_PER_DAY=3          # Bot stops executing after this many trades in a calendar day

# Symbol and timeframe.
# Phase 1.5 finding: VWAP+RSI+EMA on BTCUSDT 1D is the strongest edge
# (Sharpe ~5, MDD <3% across 1-4 year windows, IS+OOS positive). Run cron
# at 0 0 * * * (daily UTC midnight) when TIMEFRAME=1D. See STRATEGY.md.
SYMBOL=BTCUSDT
TIMEFRAME=1D

# Set to "true" to run in paper trading mode (logs decisions but never places real orders)
PAPER_TRADING=true

# ─── Optional: hosted dashboard via GitHub state push ───────────────────────
# When set, the bot mirrors safety-check-log.json + equity-history.json +
# trades.csv + rules.json + last-run.json to the specified branch on every
# cron fire. Lets a hosted dashboard read state from anywhere. Off by default.
# Bootstrap the branch first — see PHASE-0-NOTES.md "Hosted dashboard setup".
# GITHUB_STATE_TOKEN=ghp_xxx        # PAT with contents:write on the repo
# GITHUB_STATE_REPO=chidist80/claude-execute
# GITHUB_STATE_BRANCH=bot-state

# ─── Optional: Telegram push notifier ──────────────────────────────────────
# Sends a one-line summary on each cron fire (✅ ran / ⏸ no-trade / 📈/📉 trade
# / 🚫 halt / ❌ error). Get a phone push instead of checking the dashboard.
# Setup:
#   1. Talk to @BotFather → /newbot → copy the token
#   2. Send your bot any message, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates → grab "chat":{"id":...}
#   3. Set both env vars below and redeploy
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
